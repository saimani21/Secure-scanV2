# Copy this file to .env, then replace the empty secrets before using Compose.
# SECURESCAN_HMAC_KEY must be identical for the API and host worker.
SECURESCAN_HMAC_KEY=
SECURESCAN_MAX_OUTPUT_BYTES=1048576
SECURESCAN_DEFAULT_TIMEOUT_SECONDS=15

# Single-node deployment settings. Empty required values make Compose fail closed.
SECURESCAN_POSTGRES_DB=securescan
SECURESCAN_POSTGRES_USER=securescan
SECURESCAN_POSTGRES_PASSWORD=
SECURESCAN_POSTGRES_PORT=55432
SECURESCAN_API_PORT=8000
SECURESCAN_DEPLOY_DATA_ROOT=./.securescan-deploy
SECURESCAN_RUNTIME_UID=1000
SECURESCAN_RUNTIME_GID=1000

# The host CLI and worker must use the same bind-mounted storage as the API.
# Keep these as the standard direct children of SECURESCAN_DEPLOY_DATA_ROOT.
SECURESCAN_ARTIFACT_ROOT=./.securescan-deploy/artifacts
SECURESCAN_SOURCE_WORKSPACE_ROOT=./.securescan-deploy/source-workspaces
SECURESCAN_SOURCE_PROJECTION_ROOT=./.securescan-deploy/source-projections
SECURESCAN_SOURCE_RUNTIME_RECEIPT_ROOT=./.securescan-deploy/source-runtime-receipts

# SQLAlchemy URLs do not expand other variables from this file. Replace the
# password below with the same URL-unreserved value used above.
SECURESCAN_DATABASE_URL=postgresql+psycopg://securescan:replace-me@127.0.0.1:55432/securescan
SECURESCAN_ALLOW_SQLITE_SCHEMA_BOOTSTRAP=false
# Compose injects a separate internal URL using the actual service hostname:
# postgresql+psycopg://securescan:replace-me@postgres:5432/securescan
# Because Compose constructs that URL from SECURESCAN_POSTGRES_PASSWORD, use a
# strong URL-unreserved password (letters, digits, period, underscore, tilde or hyphen).

# Frozen host-worker toolchain. Verify these trusted local installations before use.
SECURESCAN_SOURCE_ENRY_HELPER_PATH=./tools/enry-helper/bin/securescan-enry-helper
# SECURESCAN_SOURCE_ENRY_HELPER_SHA256=<independently-trusted-lowercase-sha256>
SECURESCAN_SOURCE_GITLEAKS_EXECUTABLE_PATH=~/.local/securescan-tools/gitleaks/8.30.1/gitleaks
SECURESCAN_SOURCE_SYFT_EXECUTABLE_PATH=./.venv-syft-1.51/bin/syft
SECURESCAN_SOURCE_CHECKOV_EXECUTABLE_PATH=./.venv-checkov-3.3.16/bin/checkov

# PostgreSQL integration tests only. These tests destructively reset the configured database.
# The database name must end with _test and must never be the main securescan database.
# SECURESCAN_TEST_POSTGRES_URL=postgresql+psycopg://securescan:replace-me@127.0.0.1:55432/securescan_test
