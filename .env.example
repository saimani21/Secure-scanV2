# Mutable local data defaults to $XDG_DATA_HOME/securescan when XDG_DATA_HOME is
# absolute, otherwise ~/.local/share/securescan. Use absolute deployment paths
# when overriding these values; database URLs do not expand shell variables.
# SECURESCAN_DATABASE_URL=postgresql+psycopg://securescan:change-me@database/securescan
# SECURESCAN_ARTIFACT_ROOT=/var/lib/securescan/artifacts
SECURESCAN_HMAC_KEY=example-only-hmac-key-change-before-production-0001
SECURESCAN_MAX_OUTPUT_BYTES=1048576
SECURESCAN_DEFAULT_TIMEOUT_SECONDS=15

# Local-development-only PostgreSQL settings. Do not use this password in production.
SECURESCAN_POSTGRES_DB=securescan
SECURESCAN_POSTGRES_USER=securescan
SECURESCAN_POSTGRES_PASSWORD=securescan-dev-only
SECURESCAN_POSTGRES_PORT=55432

# PostgreSQL development URL:
# postgresql+psycopg://securescan:securescan-dev-only@127.0.0.1:55432/securescan

# PostgreSQL integration tests only. These tests destructively reset the configured database.
# The database name must end with _test and must never be the main securescan database.
# SECURESCAN_TEST_POSTGRES_URL=postgresql+psycopg://securescan:securescan-dev-only@127.0.0.1:55432/securescan_test
