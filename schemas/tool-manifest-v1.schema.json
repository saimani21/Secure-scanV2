{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://securescan.local/schemas/tool-manifest-v1.schema.json",
  "title": "SecureScan Tool Manifest v1",
  "type": "object",
  "required": ["tool_id", "adapter_version", "tool_version", "supported_targets", "execution", "output"],
  "properties": {
    "tool_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "adapter_version": {"type": "string", "minLength": 1},
    "tool_version": {"type": "string", "minLength": 1},
    "supported_targets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "execution": {
      "type": "object",
      "required": ["backend", "network", "timeout_seconds", "max_output_bytes"],
      "properties": {
        "backend": {"enum": ["local_process", "container", "http_service", "remote_worker"]},
        "network": {"enum": ["denied", "controlled", "required"]},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_output_bytes": {"type": "integer", "minimum": 1024}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["format", "schema_contract"],
      "properties": {
        "format": {"type": "string"},
        "schema_contract": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
